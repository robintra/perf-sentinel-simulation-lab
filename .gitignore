# JetBrains
.idea/
*.iml
*.iws
*.ipr

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Lab runtime artifacts
tmp/
*.log
kubeconfig*
.kube-config-perf-sentinel-lab

# Secrets generated at bootstrap
.postgres-password
.electricity-maps-token
*.pem
*.key
*.crt

# Helm packaged charts
charts/*.tgz

# Maven build artifacts
services/**/target/
services/**/*.iml
.mvn/wrapper/maven-wrapper.jar

# Editor swap files
*.swp
*.swo
*~

# Visual proof artifacts produced by make capture-greenops-screenshot
# (PNG, HTML, Chrome logs) stay untracked. `artifacts/fixtures/` is the
# exception: it carries the GitLab CI template test project fixtures
# and must stay versioned. Tracked extensions are .json, .toml, .yml,
# .yaml — adding a new fixture in one of those formats is automatically
# picked up by git, no .gitignore edit required.
artifacts/*
!artifacts/fixtures/
artifacts/fixtures/*
!artifacts/fixtures/*.json
!artifacts/fixtures/*.toml
!artifacts/fixtures/*.yml
!artifacts/fixtures/*.yaml
