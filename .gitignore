# JetBrains
.idea/
*.iml
*.iws
*.ipr

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Lab runtime artifacts
tmp/
*.log
kubeconfig*
.kube-config-perf-sentinel-lab

# Secrets generated at bootstrap
.postgres-password
.electricity-maps-token
*.pem
*.key
*.crt

# Helm packaged charts
charts/*.tgz

# Maven build artifacts
services/**/target/
services/**/*.iml
.mvn/wrapper/maven-wrapper.jar

# Editor swap files
*.swp
*.swo
*~

# Visual proof artifacts produced by make capture-greenops-screenshot.
# `artifacts/fixtures/` is the exception: it carries the GitLab CI
# template test project fixtures and must stay tracked. Per gitignore
# semantics we cannot un-ignore a path inside an ignored directory, so
# enumerate the files we want to keep tracked instead of ignoring the
# whole `artifacts/` directory.
artifacts/*
!artifacts/fixtures/
artifacts/fixtures/*
!artifacts/fixtures/em-real-time-traces.json
!artifacts/fixtures/perf-sentinel-test.toml
!artifacts/fixtures/gitlab-ci-from-upstream.yml
