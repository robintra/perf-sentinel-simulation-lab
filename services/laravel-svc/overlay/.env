# Baked defaults. Real container env vars (injected by the helm deployment) take
# precedence — Laravel loads this immutably, so DB_*/OTEL_* from Kubernetes win.
# Cache/session/log/view are all routed off the read-only rootfs so nothing but
# /tmp is written at runtime.
APP_NAME=laravel-svc
APP_ENV=production
APP_KEY=base64:cGVyZnNlbnRpbmVsbGFiLWxhcmF2ZWxzdmMtMDAwMDE=
APP_DEBUG=false
APP_URL=http://localhost:8095

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab
DB_USER=laravel_user
DB_PASSWORD=lab_laravel
DB_SCHEMA=laravel

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
VIEW_COMPILED_PATH=/tmp/storage/framework/views

OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_SERVICE_NAME=laravel-svc
OTEL_TRACES_SAMPLER=always_on
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_BSP_SCHEDULE_DELAY=1000
