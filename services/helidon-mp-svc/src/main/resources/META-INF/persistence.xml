<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="helidonMpPU" transaction-type="JTA">
        <jta-data-source>helidonMpDataSource</jta-data-source>

        <class>com.perfsim.helidonmpsvc.domain.Order</class>
        <class>com.perfsim.helidonmpsvc.domain.OrderItem</class>
        <class>com.perfsim.helidonmpsvc.domain.Payment</class>

        <properties>
            <!-- Schema is owned by the postgres-multistack-schemas Job.
                 Flyway runs migrations. Hibernate validates only. -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.default_schema" value="helidon_mp"/>
            <!-- batch_fetch_size=0 prevents Hibernate from collapsing lazy
                 lookups into IN queries — the n_plus_one_sql fault would
                 stop emitting N distinct SQL templates otherwise. Same
                 reasoning as the Spring Boot baseline. -->
            <property name="hibernate.default_batch_fetch_size" value="0"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
