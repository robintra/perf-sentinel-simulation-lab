<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal Maven project reproducing the "CI integration tests (Maven Failsafe)"
  recipe from the upstream docs/INSTRUMENTATION.md, Option 1 (`perf-sentinel
  capture`).

  The maven-dependency-plugin and maven-failsafe-plugin blocks below are copied
  VERBATIM from that section. If the recipe drifts, this file must be updated to
  match it, never the other way round: the point of the scenario is to run what
  the documentation actually tells users to run.

  One indirection: the OTLP endpoint is a property whose DEFAULT is the
  documented literal `http://localhost:4317`. Leg D0 runs with that default, so
  it exercises the recipe exactly as published; the later legs override it, to
  measure the rest of the capture contract independently of D0's outcome.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.perfsim.lab</groupId>
  <artifactId>java-ci-capture-it</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The documented argLine uses @{argLine}, the late-replacement placeholder
         a JaCoCo-style plugin fills in. Declared empty so the recipe can be
         pasted verbatim into a project that has no such plugin. -->
    <argLine></argLine>
    <!-- The documented value. verify.sh overrides it only where a leg needs a
         configuration that actually exports. -->
    <lab.otel.endpoint>http://localhost:4317</lab.otel.endpoint>
    <!-- The documented value. The recipe now states the protocol rather than
         relying on the agent default, which moved from grpc to http/protobuf in
         agent 2.0 — the same endpoint then means a different port. -->
    <lab.otel.protocol>grpc</lab.otel.protocol>
    <lab.items>15</lab.items>
    <lab.db.url></lab.db.url>
    <lab.fail></lab.fail>
    <junit.version>5.11.4</junit.version>
    <postgresql.version>42.7.4</postgresql.version>
    <!-- Older than the agent on purpose: the javaagent bridges API versions at
         or below its own, never above. -->
    <opentelemetry-api.version>1.40.0</opentelemetry-api.version>
    <failsafe.version>3.5.0</failsafe.version>
    <dependency-plugin.version>3.8.1</dependency-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Only used to open the SERVER span that stands in for the one a web
         framework would create. The JDBC spans themselves come from the agent. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${opentelemetry-api.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Copy the agent jar into target/ before the integration-test phase. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${dependency-plugin.version}</version>
        <executions>
          <execution>
            <id>copy-otel-agent</id>
            <phase>pre-integration-test</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.opentelemetry.javaagent</groupId>
                  <artifactId>opentelemetry-javaagent</artifactId>
                  <version>2.27.0</version> <!-- match the version baked into your Dockerfile -->
                  <destFileName>opentelemetry-javaagent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Add -javaagent to the EXISTING failsafe argLine, do not replace it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${failsafe.version}</version>
        <configuration>
          <argLine>@{argLine} -javaagent:${project.build.directory}/opentelemetry-javaagent.jar</argLine>
          <environmentVariables>
            <OTEL_TRACES_EXPORTER>otlp</OTEL_TRACES_EXPORTER>
            <OTEL_EXPORTER_OTLP_ENDPOINT>${lab.otel.endpoint}</OTEL_EXPORTER_OTLP_ENDPOINT>
            <OTEL_EXPORTER_OTLP_PROTOCOL>${lab.otel.protocol}</OTEL_EXPORTER_OTLP_PROTOCOL>
            <OTEL_SERVICE_NAME>lab-java-it</OTEL_SERVICE_NAME>
            <OTEL_TRACES_SAMPLER>always_on</OTEL_TRACES_SAMPLER>
            <OTEL_METRICS_EXPORTER>none</OTEL_METRICS_EXPORTER>
            <OTEL_LOGS_EXPORTER>none</OTEL_LOGS_EXPORTER>
            <!-- Not part of the documented recipe. The agent's default statement
                 sanitizer rewrites every literal to `?`, which collapses an N+1
                 into a redundant-query finding. Off here so the payload carries
                 the anti-pattern the assertions name, exactly like the lab's own
                 Java services. -->
            <OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED>false</OTEL_INSTRUMENTATION_COMMON_DB_STATEMENT_SANITIZER_ENABLED>
            <LAB_DB_URL>${lab.db.url}</LAB_DB_URL>
            <LAB_ITEMS>${lab.items}</LAB_ITEMS>
            <LAB_FAIL>${lab.fail}</LAB_FAIL>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
