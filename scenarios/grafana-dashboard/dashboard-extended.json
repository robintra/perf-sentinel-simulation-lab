  "description": "Lab-only overlay covering postgres-exporter pg_stat_statements panels. Daemon metrics that used to live here have been promoted to the upstream dashboard (examples/grafana-dashboard.json), 18 panels total.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Top 10 slow queries (pg_stat)",
      "description": "Most time-consuming queries via pg_stat_statements_seconds_total (postgres-exporter). Same source as `perf-sentinel report --pg-stat-prometheus`.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "topk(10, pg_stat_statements_seconds_total)", "refId": "A", "format": "table", "instant": true}
      ],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"displayMode": "color-background", "align": "left"}
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DB query rate (pg_stat)",
      "description": "Top 5 SQL templates by call rate, scraped from postgres-exporter pg_stat_statements_calls_total. Pairs with perf-sentinel slow_sql findings.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "topk(5, rate(pg_stat_statements_calls_total[5m]))", "refId": "A", "legendFormat": "{{queryid}}"}
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 10},
      "fieldConfig": {"defaults": {"unit": "ops"}}
    }
  ],
