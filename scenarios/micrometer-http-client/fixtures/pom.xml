<?xml version="1.0" encoding="UTF-8"?>
<!--
  Spring Boot 4 service traced through Micrometer Observation, never through
  the OTel Java agent. Its RestClient spans carry Micrometer's own tag names
  (method, status, http.url, uri, outcome, client.name) and no OTel HTTP key.
  Profile otlp: the spring-boot-starter-opentelemetry bridge, OTLP HTTP out.
  Profile zipkin: the Brave bridge through spring-boot-starter-zipkin, Zipkin
  v2 JSON out.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>com.perfsim.lab</groupId>
  <artifactId>micrometer-http-client</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <properties>
    <java.version>25</java.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>otlp</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <dependencies>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>zipkin</id>
      <dependencies>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-zipkin</artifactId>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
