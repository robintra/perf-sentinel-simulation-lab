---
config:
  theme: redux-dark
  layout: elk
---
flowchart LR
    subgraph subGraph0["Dev Cycle"]
        DEV(["Developer / DevOps / Software Architect"])
        LAPTOP["Local workstation<br>service under load<br>(curl / k6 / unit perf test)"]
        LOCAL_CLI[["<b>perf-sentinel CLI</b> — local dev batch<br>───────<br>mode: <i>analyze --input / report --input / inspect / pg-stat</i><br>in: <i>traces.json</i> · auto-detects native OTLP-JSON / Jaeger v1 / Zipkin v2<br>(file exporter, daemon snapshot, or Jaeger UI export)<br>Runs in Docker or directly on dev machine:<br>macOS (ARM), Windows (ARM/AMD), Linux (ARM/AMD)"]]
        LOCAL_DAEMON[["<b>perf-sentinel daemon</b> — local dev live<br>───────<br>mode: <i>watch</i> on dev workstation<br>listens on 127.0.0.1:4317 (gRPC) / 4318 (HTTP)<br>window: <i>trace_ttl_ms=30s</i> · correlation window=10min<br>scope: dev's running services only<br>tuning: <i>sanitizer_aware_classification</i> (.perf-sentinel.toml)"]]
        LOCAL_REPORT[["HTML report<br>(local dev)"]]
        LOCAL_TERMINAL[["Terminal output<br>(TUI/logs)"]]
        LOCAL_JSON[["JSON file<br>(local dev output)"]]
        LOCAL_API[["HTTP API endpoints<br>/api/findings · /api/correlations<br>/api/explain/&lt;trace-id&gt; · /api/export/report"]]
        GIT(("Git repo<br>application code"))
    end
    subgraph subGraph1["CI Pipeline"]
        CI["CI runner<br>perf integration tests<br>(k6 / JMeter / Gatling)"]
        CI_CLI[["<b>perf-sentinel CLI</b> — CI gate<br>───────<br>mode: <i>analyze --ci</i> · <i>tempo --endpoint</i> · <i>jaeger-query --endpoint</i> · <i>pg-stat</i><br>in: <i>traces.json</i> from IT or trace store HTTP API<br>+ optional <i>--pg-stat &lt;csv&gt;</i> or <i>--pg-stat-prometheus &lt;url&gt;</i>"]]
        CI_REPORT[["HTML report<br>(CI pipeline)"]]
        CI_TERMINAL[["Terminal output<br>(logs, CI)"]]
        CI_JSON[["SARIF/JSON file<br>(CI output)"]]
        GATE{"Quality gate"}
    end
    subgraph subGraph2["Staging Deployment"]
        STG_POD["Pod: focus-service<br>(staging release candidate)"]
        SIDECAR[["<b>perf-sentinel daemon</b> — sidecar mode<br>───────<br>mode: <i>watch</i> (per-pod, in same network ns)<br>window: <i>trace_ttl_ms=30s</i> · correlation window=10min<br>scope: pod-only (no cross-service correlations)<br>tuning: <i>sanitizer_aware_classification</i> = auto/strict/always/never<br>(disambiguates N+1 SQL vs redundant SQL when OTel sanitizer is on)"]]
        OPS(["QA / SRE / On-call"])
        LOG_AGG(("Log aggregator<br>Loki · Elasticsearch · Splunk<br>(via kubectl logs / fluent-bit)"))
    end
    subgraph subGraph3["Production Deployment"]
        PROD_SVC["Production services<br>(fleet)"]
        PROD_COL["OTel Collector<br>regional"]
        PROD_DAEMON[["<b>perf-sentinel daemon</b> — centralized mode<br>───────<br>mode: <i>watch</i> (1 daemon for the whole fleet)<br>window: <i>trace_ttl_ms=30s</i> · correlation window=10min<br>capacity: <i>max_active_traces=10000</i> (LRU eviction)<br>scope: cross-service correlations available<br>tuning: <i>sanitizer_aware_classification</i> = auto/strict/always/never<br>(disambiguates N+1 SQL vs redundant SQL when OTel sanitizer is on)"]]
        TRACES(("Trace store<br>Tempo · VictoriaTraces · Jaeger<br>(any backend with OTLP-JSON<br>or Jaeger query API)"))
        API_ENDPOINTS[["HTTP API endpoints<br>/api/status · /api/findings<br>/api/correlations · /api/explain/&lt;trace-id&gt;<br>/api/export/report"]]
        REPORT_FILE[["HTML report<br>(standalone dashboard file)"]]
        PROM(("Prometheus<br>scrapes :4318/metrics<br>(any daemon: sidecar or centralized)<br>+ scrapes postgres_exporter"))
        POSTGRES(("PostgreSQL<br>+ pg_stat_statements ext.<br>shared_preload_libraries"))
        PG_STAT_CSV[["pg-stat.csv<br>(queryid, query, calls,<br>total/mean exec time, rows,<br>shared_blks)"]]
        PG_EXPORTER["postgres_exporter<br>:9187/metrics"]
    end
    DEV -- (1) run local perf test --> LAPTOP & LAPTOP
LAPTOP -- "(2) traces.json" --> LOCAL_CLI & LOCAL_CLI
LOCAL_CLI -- HTML report output --> LOCAL_REPORT & LOCAL_REPORT
LOCAL_CLI -- Terminal output (TUI/logs) --> LOCAL_TERMINAL & LOCAL_TERMINAL
LOCAL_CLI -- JSON file output --> LOCAL_JSON & LOCAL_JSON
LOCAL_CLI -- (3) findings &rarr; fix --> DEV & DEV
LAPTOP -. "(2-bis) alt: OTLP localhost:4317<br>live mode while coding" .-> LOCAL_DAEMON
LOCAL_DAEMON -- "/api/findings · /api/correlations" --> LOCAL_API
LOCAL_DAEMON -- "NDJSON stdout" --> LOCAL_TERMINAL
LOCAL_DAEMON -. "snapshot via curl /api/export/report \| report --input -" .-> LOCAL_REPORT
LOCAL_API -- "polled by" --> DEV
DEV -- (4) git push --> GIT
GIT -- (5) trigger CI --> CI
CI -- (6) capture traces from IT --> CI_CLI
CI_CLI -- HTML report output --> CI_REPORT
CI_CLI -- Terminal output (logs) --> CI_TERMINAL
CI_CLI -- SARIF/JSON output --> CI_JSON
CI_CLI -- (7) exit code --> GATE
GATE -- (8) merge if PASS --> GIT
GIT -- (9) deploy to staging --> STG_POD
STG_POD -- (10) OTLP localhost:14318 --> SIDECAR
SIDECAR -- (11) /api/findings --> OPS
SIDECAR -- NDJSON stdout --> LOG_AGG
GIT -- (12) promote to prod --> PROD_SVC
PROD_SVC -- OTLP via Collector --> PROD_COL
PROD_SVC -- (13) OTLP direct (heavy svc) --> PROD_DAEMON
PROD_COL -- (14) OTLP --> PROD_DAEMON
PROD_COL -- OTLP --> TRACES
PROD_DAEMON -- NDJSON stdout --> LOG_AGG
PROD_DAEMON -- (15) live polling --> API_ENDPOINTS
PROD_DAEMON -- snapshot --> REPORT_FILE
API_ENDPOINTS -- polled by --> OPS
REPORT_FILE -- "post-mortem review" --> OPS
PROD_DAEMON -- Prometheus scrape /metrics --> PROM
TRACES -.-> CI_CLI
PROD_SVC -- SQL queries --> POSTGRES
POSTGRES -- "psql \copy CSV export<br>(on-demand or scheduled)" --> PG_STAT_CSV
POSTGRES -- scrapes pg_stat_statements --> PG_EXPORTER
PG_EXPORTER -- Prometheus exposition --> PROM
DEV -. "(D) live prod triage<br>curl /api/findings · /api/correlations (JSON)<br>curl /api/export/report \| report --input - (HTML)<br>kubectl logs deploy/perf-sentinel-daemon -f (NDJSON)" .-> API_ENDPOINTS
API_ENDPOINTS -. "(E) curl /api/export/report (Report JSON)<br>fed to local report --input -<br>→ HTML with correlations preserved<br>(daemon's rolling window snapshot)" .-> LOCAL_CLI
PG_STAT_CSV -. "(A) --pg-stat &lt;csv&gt; flag<br>fed to analyze / report / pg-stat" .-> CI_CLI
PG_STAT_CSV -. (A) same flag<br>for local triage .-> LOCAL_CLI
PG_EXPORTER -. "(B) --pg-stat-prometheus &lt;url&gt;<br>direct HTTP GET on postgres_exporter" .-> CI_CLI
PROM -. "(B) --pg-stat-prometheus &lt;url&gt;<br>via the cluster Prometheus" .-> CI_CLI
LOG_AGG -- search / alert --> OPS
PROM -- scrape metrics --> GRAFANA(("Grafana dashboard<br>(examples/grafana-dashboard.json)<br>perf_sentinel_findings_total<br>perf_sentinel_io_waste_ratio<br>perf_sentinel_service_io_ops_total"))
GRAFANA -- live charts --> OPS

DEV:::actor
LOCAL_CLI:::sentinel
LOCAL_DAEMON:::sentinel
LOCAL_API:::report
LOCAL_REPORT:::report
LOCAL_TERMINAL:::report
LOCAL_JSON:::report
CI_CLI:::sentinel
CI_REPORT:::report
CI_TERMINAL:::report
CI_JSON:::report
SIDECAR:::sentinel
OPS:::actor
PROD_DAEMON:::sentinel
API_ENDPOINTS:::report
REPORT_FILE:::report
PG_STAT_CSV:::report
classDef sentinel stroke:#1a73e8,stroke-width:2px
classDef actor stroke:#b08900,stroke-width:2px,stroke-dasharray:4 2
classDef report stroke:#34a853,stroke-width:2px
classDef compact fill:none,stroke:none,padding:0,margin:0
classDef subGraph0 fill:none,stroke:none
