{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Findings totaux",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(perf_sentinel_findings_total)",
          "refId": "A",
          "legendFormat": "total"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 100}]},
          "unit": "short"
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Traces actives",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "perf_sentinel_active_traces", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "id": 2
    },
    {
      "type": "stat",
      "title": "Ratio IO evitable",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "perf_sentinel_io_waste_ratio", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 0.3}]}
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Traces analysees",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "perf_sentinel_traces_analyzed_total", "refId": "A"}
      ],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Findings par severite (rate 5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (severity) (rate(perf_sentinel_findings_total[5m]))",
          "refId": "A",
          "legendFormat": "{{severity}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Findings par type (rate 5m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (type) (rate(perf_sentinel_findings_total[5m]))",
          "refId": "A",
          "legendFormat": "{{type}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "id": 6
    },
    {
      "type": "barchart",
      "title": "Top services par IO ops",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "topk(5, sum by (service) (perf_sentinel_service_io_ops_total))",
          "refId": "A",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "id": 7
    },
    {
      "type": "heatmap",
      "title": "Distribution duree IO (slow_duration_seconds)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (le) (rate(perf_sentinel_slow_duration_seconds_bucket[5m]))",
          "refId": "A",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 8
    },
    {
      "type": "table",
      "title": "Findings details (instant)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (type, severity) (perf_sentinel_findings_total)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "id": 9
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["perf-sentinel", "lab"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "perf-sentinel overview",
  "uid": "perf-sentinel-overview",
  "version": 1,
  "weekStart": ""
}
