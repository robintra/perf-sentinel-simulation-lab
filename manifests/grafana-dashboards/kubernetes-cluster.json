{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Pods Running by namespace",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (namespace) (kube_pod_status_phase{phase=\"Running\"})",
          "refId": "A",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ],
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "id": 1
    },
    {
      "type": "stat",
      "title": "Nodes Ready",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "CPU usage by node",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (instance) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "RAM used by node",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Container restarts (15m)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[15m]))",
          "refId": "A",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "id": 5
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["kubernetes", "lab"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Kubernetes cluster overview",
  "uid": "kubernetes-cluster-lab",
  "version": 1,
  "weekStart": ""
}
